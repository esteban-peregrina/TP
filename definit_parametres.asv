clear all;

%% Parametres
k0 = 300; % N/m
k1 = 100; % N/m
k2 = 50;  % N/m

b0 = 30; % Ns/m
b1 = 40; % Ns/m
b2 = 8;  % Ns/m

m1 = 1; % kg
m2 = 1; % kg
m3 = 4; % kg

 %% transfer functions
 F1 = [k1+k0 ; b0+b1; m1]
 F2 = -[k1; b1];
 F3 = F2;
 F4 = [k1+k2; b1+b2; m2];
 F5 = -[k2; b2];
 F6 = F5;
 F7 = [k2; b2; m3];
 